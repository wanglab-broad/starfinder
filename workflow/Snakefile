"""
    STARfinder Snakemake workflow: the dispatcher (design/specs/orchestration-engines.md, "Snakemake").

    backend: matlab runs the frozen MATLAB workflow (rules/legacy.smk: its schema validation, rule files, rule order
    and local rules, unchanged; D7). Every other configuration is the Python workflow: rules/tasks.smk runs the plan
    (starfinder workflow plan) once and defines one rule per rule group of its manifest, each running the task's
    starfinder workflow command (D1, D2). This file reads no configuration key other than backend.
"""

if config.get("backend") == "matlab":

    include: "rules/legacy.smk"

    TARGETS = get_overall_output

else:

    include: "rules/tasks.smk"

    TARGETS = TASK_RECORDS

### ==================== [ Main Target Rule ] =========================

# The default target: the MATLAB workflow's outputs, or every task record of the plan's manifest.
rule all:
    input:
        TARGETS
