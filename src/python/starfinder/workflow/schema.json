{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "starfinder.workflow.config.schema.json",
 "title": "The Python configuration shape of the STARfinder workflow (design/specs/orchestration.md)",
 "description": "A present block enables its step; the block translators check the keys inside the blocks. The plan validates against this schema without inserting defaults; the resolved configuration writes them.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "root_input_path",
  "dataset_id",
  "sample_id",
  "root_output_path",
  "output_id",
  "n_rounds",
  "ref_round",
  "rotate_angle"
 ],
 "properties": {
  "backend": {
   "enum": [
    "python"
   ]
  },
  "root_input_path": {
   "type": "string",
   "minLength": 1
  },
  "dataset_id": {
   "type": "string",
   "minLength": 1
  },
  "sample_id": {
   "type": "string",
   "minLength": 1
  },
  "root_output_path": {
   "type": "string",
   "minLength": 1
  },
  "output_id": {
   "type": "string",
   "minLength": 1
  },
  "fov_list": {
   "type": [
    "string",
    "null"
   ],
   "minLength": 1
  },
  "selected_fovs": {
   "type": [
    "array",
    "null"
   ],
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "n_rounds": {
   "type": "integer",
   "minimum": 1
  },
  "ref_round": {
   "type": "string",
   "minLength": 1
  },
  "ref_channel": {
   "type": [
    "string",
    "null"
   ]
  },
  "reference_stains": {
   "type": [
    "array",
    "null"
   ],
   "items": {
    "type": "object"
   }
  },
  "seq_channel_order": {
   "type": "array",
   "items": {
    "anyOf": [
     {
      "type": "string",
      "minLength": 1
     },
     {
      "type": "object"
     }
    ]
   }
  },
  "additional_round": {
   "type": [
    "array",
    "null"
   ],
   "items": {
    "type": "object",
    "required": [
     "round_name"
    ],
    "properties": {
     "round_name": {
      "type": "string",
      "minLength": 1
     },
     "channel_order": {
      "type": [
       "array",
       "null"
      ],
      "items": {
       "anyOf": [
        {
         "type": "string",
         "minLength": 1
        },
        {
         "type": "object"
        }
       ]
      }
     }
    }
   }
  },
  "rotate_angle": {
   "type": "number"
  },
  "voxel_size_xy": {
   "type": [
    "number",
    "null"
   ],
   "exclusiveMinimum": 0
  },
  "voxel_size_z": {
   "type": [
    "number",
    "null"
   ],
   "exclusiveMinimum": 0
  },
  "reference_image": {
   "type": "string",
   "minLength": 1
  },
  "reference_image_import": {
   "type": [
    "string",
    "null"
   ]
  },
  "image_dir_template": {
   "enum": [
    "{round}/{fov}",
    "{fov}/{round}"
   ]
  },
  "readout_mode": {
   "enum": [
    "multiplexed",
    "direct"
   ]
  },
  "codebook": {
   "type": [
    "string",
    "null"
   ]
  },
  "direct_panel": {
   "type": [
    "string",
    "null"
   ]
  },
  "deconvolution": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "iterations"
   ],
   "description": "The deconvolution stage (design/specs/deconvolution.md): a present block makes the plan deconvolve the rounds it names with deconwolf into a TIFF copy that the FOV tasks read.",
   "properties": {
    "rounds": {
     "type": [
      "array",
      "null"
     ],
     "items": {
      "type": "string",
      "minLength": 1
     },
     "description": "The rounds to deconvolve: round names and reference_stain; null deconvolves the sequencing rounds."
    },
    "copy_root": {
     "type": "string",
     "minLength": 1,
     "description": "Where the copy lies: output (under the output root), beside (beside the dataset's folder) or an absolute path."
    },
    "iterations": {
     "type": "integer",
     "minimum": 1,
     "description": "deconwolf's iterations; required, no default."
    },
    "method": {
     "enum": [
      "shb"
     ],
     "description": "deconwolf's method: shb, the one offered (SHBCL2 on the GPU)."
    },
    "border_quality": {
     "type": "integer",
     "minimum": 0,
     "maximum": 2,
     "description": "deconwolf's border quality."
    },
    "tile_size": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 1,
     "description": "deconwolf's --tilesize in pixels; null runs untiled."
    },
    "dtype": {
     "enum": [
      "uint8",
      "uint16"
     ],
     "description": "The copy's dtype: uint8 with one stretch factor per (FOV, round), or uint16 with a fixed scale."
    },
    "scale": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "number",
       "exclusiveMinimum": 0
      },
      {
       "type": "object",
       "additionalProperties": {
        "type": "object",
        "additionalProperties": {
         "type": "number",
         "exclusiveMinimum": 0
        }
       }
      }
     ],
     "description": "With dtype uint16: the stored value per grey level, a number (default 64) or {<round>: {<label>: number}}."
    },
    "psf": {
     "type": "object",
     "additionalProperties": false,
     "description": "The point spread function: generated from the optics, or supplied files.",
     "properties": {
      "source": {
       "enum": [
        "generate",
        "file"
       ]
      },
      "files": {
       "type": [
        "object",
        "null"
       ],
       "additionalProperties": {
        "type": "string",
        "minLength": 1
       }
      },
      "voxel_size_um": {
       "anyOf": [
        {
         "type": "null"
        },
        {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "xy",
          "z"
         ],
         "properties": {
          "xy": {
           "type": "number",
           "exclusiveMinimum": 0
          },
          "z": {
           "type": "number",
           "exclusiveMinimum": 0
          }
         }
        }
       ]
      },
      "na": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "immersion_ri": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "sample_ri": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "pinhole_radius_nm": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "depth_um": {
       "type": "number",
       "minimum": 0
      },
      "shape_zyx": {
       "type": "array",
       "items": {
        "type": "integer",
        "minimum": 1
       },
       "minItems": 3,
       "maxItems": 3
      },
      "channels": {
       "type": [
        "object",
        "null"
       ],
       "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "excitation_nm": {
          "type": "number",
          "exclusiveMinimum": 0
         },
         "emission_nm": {
          "type": "number",
          "exclusiveMinimum": 0
         }
        }
       }
      }
     }
    }
   }
  },
  "processing": {
   "type": [
    "object",
    "null"
   ],
   "additionalProperties": false,
   "properties": {
    "mode": {
     "enum": [
      "direct",
      "tiled"
     ]
    },
    "tiled": {
     "type": [
      "object",
      "null"
     ],
     "additionalProperties": false,
     "properties": {
      "tile_size_yx": {
       "type": "integer",
       "minimum": 1,
       "description": "The largest tile edge in Y and X, in voxels (default 512)."
      },
      "halo": {
       "type": [
        "integer",
        "null"
       ],
       "minimum": 0,
       "description": "The halo in voxels; null is the plan's minimum, the largest footprint of the tile's operations; regional maxima meeting the core must also fit the window, checked by the tile task."
      },
      "local_registration": {
       "type": [
        "object",
        "null"
       ],
       "description": "A registration recipe run on each tile's window, or null."
      },
      "post_local_registration": {
       "type": [
        "array",
        "null"
       ],
       "description": "Preprocessing steps run in the tile after its local registration, or null."
      },
      "exact": {
       "type": "boolean",
       "description": "true (default): refuse operations without a finite footprint and fail a tile when a regional maximum meeting its core touches an internal window edge, naming a conservative containing halo covering the full FOV; false records per-channel truncated_maxima counts."
      }
     }
    },
    "checkpoints": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "enum": [
       "registered",
       "candidates",
       "pre_qc"
      ]
     }
    },
    "spot_finding_input": {
     "type": [
      "string",
      "null"
     ],
     "minLength": 1
    },
    "streaming": {
     "type": "boolean"
    },
    "device": {
     "enum": [
      "cpu"
     ]
    },
    "load_codebook": {
     "type": [
      "object",
      "null"
     ]
    },
    "load_raw_images": {
     "type": [
      "object",
      "null"
     ]
    },
    "preprocessing": {
     "type": "object"
    },
    "registration": {
     "type": "object"
    },
    "reference_image_view": {
     "type": "object",
     "properties": {
      "mode": {
       "enum": [
        "max",
        "channel"
       ]
      },
      "projection": {
       "enum": [
        null,
        "max"
       ]
      }
     }
    },
    "spot_finding": {
     "type": [
      "object",
      "null"
     ],
     "properties": {
      "device": {
       "enum": [
        "cpu",
        "cuda"
       ],
       "description": "The spot-finding device (default cpu); cuda for spotiflow and piscis, whose direct fov task then asks for a GPU. Registration and readout stay on the CPU (processing.device)."
      }
     }
    },
    "reads_extraction": {
     "type": [
      "object",
      "null"
     ]
    },
    "reads_filtration": {
     "type": [
      "object",
      "null"
     ]
    },
    "decoding": {
     "type": "object"
    },
    "scoring": {
     "anyOf": [
      {
       "const": false
      },
      {
       "type": "object"
      }
     ]
    },
    "deduplication": {
     "type": [
      "object",
      "null"
     ]
    }
   }
  },
  "morphology": {
   "type": [
    "object",
    "null"
   ],
   "additionalProperties": false,
   "properties": {
    "rounds": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "recipe": {
     "type": [
      "object",
      "null"
     ]
    },
    "channel_images": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "projection": {
         "enum": [
          null,
          "max"
         ]
        }
       }
      }
     ]
    }
   }
  },
  "segmentation": {
   "type": "object",
   "properties": {
    "device": {
     "enum": [
      "cpu",
      "cuda"
     ]
    },
    "input_recipes": {
     "type": "object"
    },
    "runs": {
     "type": "array",
     "minItems": 1
    }
   }
  },
  "assignment": {
   "type": [
    "object",
    "null"
   ],
   "properties": {
    "previews": {
     "type": "boolean"
    },
    "name": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "stitching": {
   "type": "object",
   "properties": {
    "dataset_xml": {
     "type": [
      "string",
      "null"
     ]
    },
    "view_map": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "assembly": {
   "type": [
    "object",
    "null"
   ]
  },
  "export": {
   "type": [
    "object",
    "null"
   ],
   "properties": {
    "previews": {
     "type": "boolean"
    }
   }
  },
  "report": {
   "type": [
    "object",
    "null"
   ]
  },
  "execution": {
   "type": [
    "object",
    "null"
   ],
   "additionalProperties": false,
   "properties": {
    "defaults": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "threads": {
       "type": "integer",
       "minimum": 1
      },
      "memory_mb": {
       "type": "integer",
       "minimum": 1
      },
      "runtime_min": {
       "type": "integer",
       "minimum": 1
      },
      "gpu": {
       "type": "boolean"
      }
     }
    },
    "tasks": {
     "type": "object",
     "propertyNames": {
      "enum": [
       "psf",
       "deconvolve",
       "summarize",
       "merge",
       "fov",
       "tile_global",
       "tile",
       "tile_merge",
       "morphology",
       "segment",
       "assign",
       "bigstitcher_macro",
       "bigstitcher_engine",
       "bigstitcher_import",
       "stitch",
       "export",
       "report",
       "compare"
      ]
     },
     "additionalProperties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "threads": {
        "type": "integer",
        "minimum": 1
       },
       "memory_mb": {
        "type": "integer",
        "minimum": 1
       },
       "runtime_min": {
        "type": "integer",
        "minimum": 1
       },
       "gpu": {
        "type": "boolean"
       }
      }
     }
    },
    "container": {
     "type": [
      "string",
      "null"
     ]
    },
    "fiji": {
     "type": [
      "string",
      "null"
     ]
    },
    "resume_from_checkpoint": {
     "type": "boolean"
    },
    "code_version": {
     "enum": [
      "keep",
      "rerun"
     ]
    },
    "log_level": {
     "enum": [
      "INFO",
      "DEBUG"
     ]
    },
    "image_compression": {
     "enum": [
      "zlib",
      "none"
     ]
    },
    "deconwolf": {
     "type": [
      "string",
      "null"
     ]
    },
    "deconwolf_wisdom": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  }
 }
}
