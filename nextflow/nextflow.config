manifest.nextflowVersion = '!>=26.10.4'
nextflow.enable.dsl = 2
params {
    config = null
    container = null
    require_container = false
    max_retries = 2
    weights_dir = null
    stub_runner = "${projectDir}/bin/stub_task.sh"
}
process {
    cpus = 1
    memory = '1 GB'
    time = '5 min'
    container = params.container
    errorStrategy = { task.exitStatus in [2, 3] ? 'finish' : 'retry' }
    maxRetries = params.max_retries
    withLabel: 'cpu|gpu' {
        // Look up resources outside the hashed inputs; a memory/time change keeps the cache.
        ext.entry = { new groovy.json.JsonSlurper().parse(new File(manifest_path)).tasks.find { it.id == task_id } }
        cpus = { task.ext.entry.execution.threads }
        memory = { "${task.ext.entry.execution.memory_mb * task.attempt} MB" }
        time = { "${task.ext.entry.execution.runtime_min * task.attempt} min" }
        container = { task.ext.entry.execution.container ?: params.container }
    }
    withLabel: gpu {
        accelerator = { workflow.stubRun ? 0 : 1 }
    }
}
profiles {
    local { includeConfig 'conf/local.config' }
    sge { includeConfig 'conf/sge.config' }
    'google-batch' { includeConfig 'conf/google_batch.config' }
}
trace {
    fields = 'task_id,hash,native_id,name,status,exit,submit,start,complete,duration,realtime,attempt,tag'
    raw = true
}
