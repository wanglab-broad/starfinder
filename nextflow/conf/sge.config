params.require_container = true
process {
    executor = 'sge'
    // Above one CPU only, as the Snakemake profile: UGER's smp holds a job to h_vmem x (slots + 1)
    // (job_is_first_task FALSE), so a 1-CPU task in smp could use twice its request (W-778).
    penv = { task.cpus > 1 ? 'smp' : null }
    // Math.ceil: Groovy's BigDecimal has no ceil() on Nextflow 26.10.4 (W-768).
    clusterOptions = { "-P broad -S /bin/bash -l h_vmem=${Math.ceil(task.memory.toMega() / task.cpus) as long}M -l h_rt=${task.time.toSeconds()}" }
    // Apptainer starts from a cleared environment without the home (--no-home): pass each task's thread count, as the
    // Snakemake job script does, and keep caches in the task's work folder, which the wrapper's shell expands (W-768).
    containerOptions = { ['OMP_NUM_THREADS', 'OPENBLAS_NUM_THREADS', 'MKL_NUM_THREADS', 'ITK_GLOBAL_DEFAULT_NUMBER_OF_THREADS', 'NUMEXPR_NUM_THREADS'].collect { "--env ${it}=${task.cpus}" }.join(' ') + ' --env XDG_CACHE_HOME=$NXF_TASK_WORKDIR/.cache --env MPLCONFIGDIR=$NXF_TASK_WORKDIR/.config/matplotlib' }
    withLabel: gpu {
        clusterOptions = { "-P broad -S /bin/bash -l h_vmem=${Math.ceil(task.memory.toMega() / task.cpus) as long}M -l h_rt=${task.time.toSeconds()} -l gpu=TRUE,operating_system=RedHat8" }
        containerOptions = { '--nv ' + ['OMP_NUM_THREADS', 'OPENBLAS_NUM_THREADS', 'MKL_NUM_THREADS', 'ITK_GLOBAL_DEFAULT_NUMBER_OF_THREADS', 'NUMEXPR_NUM_THREADS'].collect { "--env ${it}=${task.cpus}" }.join(' ') + ' --env XDG_CACHE_HOME=$NXF_TASK_WORKDIR/.cache --env MPLCONFIGDIR=$NXF_TASK_WORKDIR/.config/matplotlib' }
    }
}
apptainer.enabled = true
// Supply execution.container as the shared-drive SIF; use -work-dir under /stanley.
apptainer.runOptions = '--bind /stanley'
