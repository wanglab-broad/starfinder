params.require_container = true
process {
    executor = 'sge'
    penv = 'smp'
    clusterOptions = { "-P broad -S /bin/bash -l h_vmem=${(task.memory.toMega() / task.cpus).ceil()}M -l h_rt=${task.time.toSeconds()}" }
    withLabel: gpu {
        clusterOptions = { "-P broad -S /bin/bash -l h_vmem=${(task.memory.toMega() / task.cpus).ceil()}M -l h_rt=${task.time.toSeconds()} -l gpu=TRUE,operating_system=RedHat8" }
        containerOptions = '--nv'
    }
}
apptainer.enabled = true
// Supply execution.container as the shared-drive SIF; use -work-dir under /stanley.
apptainer.runOptions = '--bind /stanley'
