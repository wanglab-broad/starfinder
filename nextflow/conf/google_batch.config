// Readiness only: replace placeholders after the access/budget/transfer checklist is approved.
// See design/notes/google-batch-readiness.md for the disk-backed roots.output decision.
// This profile does not stage the command's absolute input, manifest or output paths.
params {
    google_project = '<project>'
    google_region = 'us-central1'
    google_bucket = '<bucket>'
    google_run = '<run>'
    container = 'us-central1-docker.pkg.dev/<project>/<repository>/starfinder@sha256:<cpu-image-digest>'
}
google {
    project = params.google_project
    location = params.google_region
    batch.spot = true
}
workDir = "gs://${params.google_bucket}/work/${params.google_run}"
process {
    executor = 'google-batch'
    container = params.container
    // Inherit the manifest's CPUs/memory/time, failure classification and maxRetries (2).
    // Ordinary failures and preemption retry; input/refusal exits 2 and 3 still finish.
    machineType = 'n2-standard-4'
    withName: 'FOV|TILE_GLOBAL' {
        machineType = 'n2-highmem-4'
    }
    withLabel: gpu {
        machineType = 'g2-standard-4'
        accelerator = { workflow.stubRun ? 0 : [request: 1, type: 'nvidia-l4'] }
        // GPU lock/image support is deferred; W-648's learned image is CPU-only.
        container = 'us-central1-docker.pkg.dev/<project>/<repository>/starfinder@sha256:<gpu-image-digest>'
    }
}
// Offline N1: -profile google-batch,local -work-dir <local-disk-path> -stub-run.
// The local profile overrides only the executor; no container runtime is enabled locally.
