process.executor = 'local'
// Keep bounded local invocations serial; each task still requests its manifest CPUs.
executor.queueSize = 1
// The same selector as google_batch.config's VERIFY block, so that -profile google-batch,local runs every process
// locally; a withName outranks the generic executor above (W-834).
process.'withName:VERIFY_BEFORE|VERIFY_AFTER'.executor = 'local'
